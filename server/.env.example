# ---------------------------------------------------------------------------
# Chotulal Sweets - Backend environment template
# Copy this file to `.env` and fill in real values.
# ---------------------------------------------------------------------------

# Server
PORT=4000
NODE_ENV=development
# Comma separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Zero-config local development uses SQLite:
DATABASE_URL="file:./dev.db"
# For production, switch `provider` in prisma/schema.prisma to "postgresql" and use:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/chotulal?schema=public"

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# CHANGE THIS to a long random string in every environment.
JWT_SECRET=change-me-to-a-long-random-secret-string-please
JWT_EXPIRES_IN=30d

# OTP login. In development, if no SMS provider is configured the server issues
# a development OTP (printed to the console) so the flow can be tested end to end.
# Set OTP_DEV_MODE=false in production.
OTP_DEV_MODE=true
OTP_DEV_CODE=123456

# ---------------------------------------------------------------------------
# Media storage
# ---------------------------------------------------------------------------
# "local" stores files on disk under server/uploads (fine for dev / single node).
# "cloudinary" uses Cloudinary persistent object storage.
STORAGE_DRIVER=local
PUBLIC_BASE_URL=http://localhost:4000

# Cloudinary (required only when STORAGE_DRIVER=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------------------------------------------------------------------------
# Payments (Razorpay). Orders can be created without these; online payment
# simply stays disabled until keys are provided.
# ---------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Notifications (all optional). No message is ever claimed as sent unless the
# matching provider credentials are present.
# ---------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL_FROM=

# ---------------------------------------------------------------------------
# Maps. Browser Google Maps links work without a key. Server-side geocoding is
# optional and only enabled when a key is supplied.
# ---------------------------------------------------------------------------
GOOGLE_MAPS_API_KEY=

# Business defaults (also editable at runtime from the admin panel)
DELIVERY_FEE=30
FREE_DELIVERY_ABOVE=500
MIN_ORDER_AMOUNT=100
TAX_PERCENT=5
