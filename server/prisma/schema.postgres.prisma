// Production (Vercel / PostgreSQL) schema.
// Generated from schema.prisma with provider=postgresql + serverless binary targets.
// Local development keeps using schema.prisma (SQLite). Keep both in sync.

// Chotulal Sweets - database schema
// Local development uses SQLite (zero config). For production, change the
// datasource provider below to "postgresql" and set DATABASE_URL accordingly,
// then run `npm run migrate` (see README).

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Users & roles
// ---------------------------------------------------------------------------
// Single user table with a `role` field:
//   CUSTOMER | ADMIN | DELIVERY
// Staff (ADMIN/DELIVERY) authenticate with phone/email + password.
// Customers authenticate with phone + OTP.
model User {
  id           String   @id @default(cuid())
  phone        String?  @unique
  email        String?  @unique
  name         String?
  passwordHash String?
  role         String   @default("CUSTOMER")
  isActive     Boolean  @default(true)
  avatarUrl    String?
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  addresses          Address[]
  carts              Cart[]
  orders             Order[]
  deliveryProfile    DeliveryProfile?
  assignments        DeliveryAssignment[]      @relation("DeliveryBoyAssignments")
  statusChanges      OrderStatusHistory[]
  locationPings      DeliveryLocationHistory[]
  stockMovements     StockMovement[]
  auditLogs          AuditLog[]
  notifications      Notification[]

  @@index([role])
}

model DeliveryProfile {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicleType   String?
  vehicleNumber String?
  isAvailable   Boolean  @default(true)
  lastLat       Float?
  lastLng       Float?
  lastAccuracy  Float?
  lastSeenAt    DateTime?
  createdAt     DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Addresses
// ---------------------------------------------------------------------------
model Address {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label        String?
  line1        String
  line2        String?
  landmark     String?
  city         String?
  pincode      String?
  lat          Float?
  lng          Float?
  instructions String?
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Catalogue
// ---------------------------------------------------------------------------
model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  imageUrl    String?
  icon        String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  showOnHome  Boolean  @default(true)
  bannerUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products    ProductCategory[]
}

model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  sku         String?  @unique
  basePrice   Float    @default(0)
  originalPrice Float?
  unit        String?  // e.g. "per kg", "per piece"
  ingredients String?
  allergens   String?
  isActive    Boolean  @default(true)
  isFeatured  Boolean  @default(false)
  isBestseller Boolean @default(false)
  isNewArrival Boolean @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  categories  ProductCategory[]
  images      ProductImage[]
  variants    ProductVariant[]
  cartItems   CartItem[]
  orderItems  OrderItem[]

  @@index([isActive])
  @@index([isFeatured])
}

model ProductCategory {
  productId  String
  categoryId String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  sortOrder Int     @default(0)

  @@index([productId])
}

model ProductVariant {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  label      String   // "250 g", "500 g", "1 kg", "1 piece"
  weightGrams Int?
  price      Float
  originalPrice Float?
  stock      Int      @default(0)
  sku        String?  @unique
  isActive   Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  cartItems      CartItem[]
  orderItems     OrderItem[]
  stockMovements StockMovement[]

  @@index([productId])
}

// ---------------------------------------------------------------------------
// Inventory
// ---------------------------------------------------------------------------
model StockMovement {
  id         String         @id @default(cuid())
  variantId  String
  variant    ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  delta      Int            // positive = restock, negative = sale/adjustment
  reason     String         // ORDER | CANCEL_RESTORE | MANUAL_ADJUST | IMPORT | RESTOCK
  note       String?
  orderId    String?
  userId     String?
  user       User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt  DateTime       @default(now())

  @@index([variantId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Cart
// ---------------------------------------------------------------------------
model Cart {
  id        String   @id @default(cuid())
  userId    String?  // null => guest cart (identified by token)
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  guestToken String? @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items CartItem[]

  @@index([userId])
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int            @default(1)
  createdAt DateTime       @default(now())

  @@unique([cartId, variantId])
  @@index([cartId])
}

// ---------------------------------------------------------------------------
// Orders
// ---------------------------------------------------------------------------
model Order {
  id            String   @id @default(cuid())
  orderNumber   String   @unique
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  status        String   @default("PENDING_CONFIRMATION")
  // PENDING_CONFIRMATION | CONFIRMED | PREPARING | READY_FOR_PICKUP |
  // ASSIGNED_FOR_DELIVERY | PICKED_UP | OUT_FOR_DELIVERY | DELIVERED |
  // CANCELLED | FAILED_DELIVERY

  customerName  String
  customerPhone String

  subtotal      Float
  discount      Float    @default(0)
  deliveryFee   Float    @default(0)
  taxAmount     Float    @default(0)
  total         Float

  couponCode    String?
  paymentMethod String   @default("COD") // COD | ONLINE
  paymentStatus String   @default("PENDING") // PENDING | PAID | FAILED | REFUNDED

  deliveryInstructions String?
  cancelledReason      String?
  failedReason         String?

  placedAt      DateTime @default(now())
  confirmedAt   DateTime?
  deliveredAt   DateTime?
  updatedAt     DateTime @updatedAt

  deliveryAddress   OrderDeliveryAddress?
  items             OrderItem[]
  payments          Payment[]
  statusHistory     OrderStatusHistory[]
  assignment        DeliveryAssignment?
  locationHistory   DeliveryLocationHistory[]

  @@index([status])
  @@index([placedAt])
  @@index([userId])
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId   String?
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  // Snapshots - authoritative historical values
  name        String
  variantLabel String
  unitPrice   Float
  quantity    Int
  lineTotal   Float
  imageUrl    String?

  @@index([orderId])
}

model OrderDeliveryAddress {
  id           String   @id @default(cuid())
  orderId      String   @unique
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  line1        String
  line2        String?
  landmark     String?
  city         String?
  pincode      String?
  lat          Float?
  lng          Float?
  instructions String?
  confirmedAt  DateTime @default(now())
}

model Payment {
  id            String   @id @default(cuid())
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider      String   @default("COD") // COD | RAZORPAY
  providerRef   String?
  amount        Float
  currency      String   @default("INR")
  status        String   @default("PENDING") // PENDING | PAID | FAILED | REFUNDED
  signature     String?
  rawPayload    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([orderId])
}

model OrderStatusHistory {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    String
  note      String?
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([orderId])
}

// ---------------------------------------------------------------------------
// Delivery
// ---------------------------------------------------------------------------
model DeliveryAssignment {
  id           String   @id @default(cuid())
  orderId      String   @unique
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  deliveryBoyId String?
  deliveryBoy  User?    @relation("DeliveryBoyAssignments", fields: [deliveryBoyId], references: [id], onDelete: SetNull)
  assignedAt   DateTime @default(now())
  acceptedAt   DateTime?
  pickedUpAt   DateTime?
  deliveredAt  DateTime?
  failedAt     DateTime?
  trackingActive Boolean @default(false)
  trackingStartedAt DateTime?
  trackingStoppedAt DateTime?
  note         String?

  @@index([deliveryBoyId])
}

model DeliveryLocationHistory {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  lat         Float
  lng         Float
  accuracy    Float?
  recordedAt  DateTime @default(now())

  @@index([orderId])
  @@index([recordedAt])
}

// ---------------------------------------------------------------------------
// Discounts
// ---------------------------------------------------------------------------
model Coupon {
  id          String   @id @default(cuid())
  code        String   @unique
  description String?
  type        String   @default("PERCENT") // PERCENT | FLAT
  value       Float    @default(0)
  minOrder    Float    @default(0)
  maxDiscount Float?
  isActive    Boolean  @default(true)
  usageLimit  Int?
  usedCount   Int      @default(0)
  startsAt    DateTime?
  expiresAt   DateTime?
  createdAt   DateTime @default(now())

  @@index([code])
}

// ---------------------------------------------------------------------------
// Homepage content management
// ---------------------------------------------------------------------------
model HomepageBanner {
  id          String   @id @default(cuid())
  title       String
  subtitle    String?
  description String?
  imageUrl    String
  ctaLabel    String?
  ctaLink     String?
  bgColor     String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model HomepageSection {
  id        String   @id @default(cuid())
  key       String   @unique  // FEATURED | NEW_ARRIVALS | OFFERS | category slug etc.
  title     String
  type      String   @default("PRODUCT_CAROUSEL") // PRODUCT_CAROUSEL | CATEGORY_CAROUSEL
  categoryId String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
}

// ---------------------------------------------------------------------------
// Settings / notifications / audit
// ---------------------------------------------------------------------------
model ShopSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

model Notification {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId   String?
  type      String
  title     String
  body      String?
  channel   String   @default("IN_APP") // IN_APP | SMS | WHATSAPP | EMAIL
  isRead    Boolean  @default(false)
  sent      Boolean  @default(false)
  providerResult String?
  createdAt DateTime @default(now())

  @@index([userId])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entity     String?
  entityId   String?
  meta       String?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([entity])
}

