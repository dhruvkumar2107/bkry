# Client environment (Vite). Copy to `.env` to override.

# Base URL of the API. Leave empty when the API is served from the same origin
# (local dev uses the Vite proxy; Vercel rewrites /api to the serverless function).
VITE_API_BASE=

# Enable Socket.IO realtime updates. Only works on a long-lived server.
# Leave false/unset on serverless hosts (e.g. Vercel); the UI then polls the API.
VITE_ENABLE_SOCKETS=false
